# QATOOL environment. Copy to .env (Git-ignored) and fill in. Names and safe defaults only:
# this file must never contain a real key, token or address you want kept private.
# Read by `node --env-file-if-exists=.env` (npm start / dev:server) and by Docker Compose (env_file).
# A variable already set in the process wins over .env. Docs: README.md, docs/IMPLEMENTATION.md
# section 17, docs/PUBLIC_DEMO_SECURITY.md.

# ---- Server -------------------------------------------------------------------------------
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info
SIT_TEMPLATE_PATH=templates/sit-script-template.xlsx
# Ceiling for a JSON request body and, locally, for one uploaded file (bytes).
MAX_BODY_BYTES=26214400

# ---- Model providers ----------------------------------------------------------------------
# Server default for a request that names no provider: gemini | mock | apayee.
# PUBLIC_MODE refuses apayee here; the owner picks Claude per run in the UI instead.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_TIMEOUT_MS=120000
LLM_MAX_OUTPUT_TOKENS=32768
# LLM_TEMPERATURE is left unset on purpose (Gemini 3).

# ---- Apayee (Claude gateway) --------------------------------------------------------------
# On the host: http://127.0.0.1:4100. Docker Compose overrides this to http://apayee:4100.
APAYEE_BASE_URL=http://127.0.0.1:4100
# Must equal Apayee's APAYEE_AUTH_TOKEN.
APAYEE_TOKEN=
APAYEE_QUEUE_WAIT_MS=60000

# ==== Public mode (docs/PUBLIC_DEMO_SECURITY.md) ===========================================
# Off by default: local development is unchanged. Turn it on only behind Cloudflare Access.
# When true the backend refuses to start unless the four required values below are set.
PUBLIC_MODE=false

# Required when PUBLIC_MODE=true
#   ACCESS_TEAM_DOMAIN  your Access team domain, e.g. myteam.cloudflareaccess.com
#   ACCESS_AUD          the Access application's audience tag
#   OWNER_EMAILS        comma-separated; only these accounts may use the API
#   ALLOWED_ORIGINS     comma-separated exact origins of the public frontend,
#                       e.g. https://demo.example.com (no path, no wildcard)
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
OWNER_EMAILS=
ALLOWED_ORIGINS=

# Peers whose CF-Connecting-IP header is believed, for log lines only. Empty = nobody.
# Behind Docker Desktop with Compose the host's cloudflared appears as the network gateway
# (172.18.0.1 when measured); confirm from the `peer_ip` field of a request log line.
TRUSTED_PROXY_PEERS=

# ---- Limits. Blank = the default for the mode (public or demo / local) ---------------------
# Uploads (public or demo / local): per file 10 MiB / MAX_BODY_BYTES, total 20 MiB / 100 MiB.
# The file count is a technical ceiling (30 / 20), not a product rule: the byte limits and the
# structuring budget decide how much fits.
# UPLOAD_MAX_FILES=
# UPLOAD_MAX_FILE_BYTES=
# UPLOAD_MAX_TOTAL_BYTES=
# DOCX/XLSX archives (all modes): 2000 entries, 64 MiB inflated.  PDF pages: 150 / 300.
# ZIP_MAX_ENTRIES=
# ZIP_MAX_UNCOMPRESSED_BYTES=
# PDF_MAX_PAGES=
# Spreadsheet and Word ceilings (public or demo / local): sheets 20 / 100, rows 20000 / 200000,
# cells 200000 / 2000000, one inflated XML part 16 MiB / 64 MiB.
# XLSX_MAX_SHEETS=
# XLSX_MAX_ROWS=
# XLSX_MAX_CELLS=
# XML_PART_MAX_BYTES=
# JSON request bodies (public or demo 5 MiB / local MAX_BODY_BYTES) and time to receive a request.
# JSON_BODY_MAX_BYTES=
# REQUEST_TIMEOUT_MS=
# Owner-mode model gate (PUBLIC_MODE / local). 0 = no limit. There is NO model request budget:
# no hourly or daily count exists, and LLM_BUDGET_PER_* are ignored.
#   concurrent model calls 1 / 0, queue 2 deep and 20 s, whole-request deadline 110 s / none
#   (must be <= 115000 in PUBLIC_MODE: Cloudflare's proxy read timeout is 125 s),
#   requests per minute 120 / 0.
# LLM_MAX_CONCURRENT=
# LLM_QUEUE_MAX=
# LLM_QUEUE_WAIT_MS=
# REQUEST_DEADLINE_MS=
# RATE_LIMIT_PER_MINUTE=

# ---- Public demo (PUBLIC_DEMO=true): visitors, Turnstile tickets and the async job API ------
# A third mode, beside local and PUBLIC_MODE (owner-only). It cannot be combined with
# PUBLIC_MODE. Visitors get a short-lived ticket after a Turnstile check and work through
# /api/jobs; the model is fixed on the server to Claude through Apayee and a visitor cannot
# name another. Not enabled by default. See docs/PUBLIC_DEMO_SECURITY.md.
# PUBLIC_DEMO=false
# Required when on. Random, at least 32 characters; signs the HS256 tickets. Keep it in the
# environment so tickets survive a restart.
# TICKET_SECRET=
# Required when on. The Turnstile widget's SECRET key, and the hostname(s) the widget runs
# on (comma-separated, no scheme) and the action the frontend sets on it.
# TURNSTILE_SECRET=
# TURNSTILE_HOSTNAMES=demo.example.com
# TURNSTILE_ACTION=qatool_demo
# ALLOWED_ORIGINS above is required too: it is the frontend's origin and the ticket's audience.
# TICKET_ISSUER=qatool
# TICKET_TTL_SECONDS=1800
# TURNSTILE_MAX_AGE_MS=300000
# TURNSTILE_TIMEOUT_MS=5000
# A loose backstop on ticket minting per client address (see TRUSTED_PROXY_PEERS).
# SESSION_MINT_PER_MINUTE_PER_IP=30
# Jobs. Capacity is workers running + JOB_MAX_PENDING waiting. Workers are 1 unless raised,
# at most 3, and never more than the gateway's max_active (Apayee decides that).
# JOB_WORKERS=1
# JOB_MAX_PENDING=10
# JOB_LEASE_MS=45000
# JOB_DEADLINE_MS=0              0 = 3 x LLM_TIMEOUT_MS + 2 minutes, from when a worker starts
# JOB_RETAIN_COMPLETED_MS=900000
# JOB_RETAIN_FAILED_MS=300000
# JOB_MAX_TERMINAL=30
# JOB_SUBMIT_PER_MINUTE=10       per ticket
# JOB_POLL_PER_MINUTE=60         per ticket; also the burst limit of validate/export/health
# JOB_POLL_INTERVAL_MS=2500
# UPLOAD_INFLIGHT_MAX=4          uploads being read or parsed at once, across all visitors
# PARSE_CONCURRENCY=1
# PARSE_TIMEOUT_MS=20000         one upload is read on its own thread; ended at this limit
# PARSE_MAX_HEAP_MB=384
# PARSED_TEXT_MAX_CHARS=2000000
# PROVIDER_BREAKER_COOLDOWN_MS=60000
