# Backend settings for the free staging deployment (https://qatool-staging.vercel.app + a Quick Tunnel).
# docs/STAGING_DEPLOYMENT.md sections 4 and 5.
#
# THIS FILE IS NOT READ BY ANYTHING. It is a checklist of the lines to ADD to your real .env, in an editor
# (notepad .env). Do not copy it over .env: .env also holds APAYEE_TOKEN and your other settings.
# Never paste a real value into this file, a chat or a terminal log. Secrets are left blank on purpose.
#
# Backend only. Nothing here may ever go to Vercel or get a VITE_ name.

# Order matters: fill in everything below first and switch PUBLIC_DEMO to true LAST.
# While it is false the backend has no authentication, so no tunnel may be running.
PUBLIC_DEMO=false

# The exact origin the browser sends: scheme + host, no path, no trailing slash, no wildcard.
# It is also the ticket's audience. One entry. Not the tunnel's address.
ALLOWED_ORIGINS=https://qatool-staging.vercel.app

# At least 32 random characters, generated on this PC (the PowerShell snippet in section 5 of the
# runbook copies one to the clipboard without printing it). Changing it signs every visitor out.
TICKET_SECRET=

# The Turnstile widget's SECRET key, from the Cloudflare dashboard. Never the site key.
TURNSTILE_SECRET=

# The hostname the widget runs on: hostname only, no scheme. Must match the widget's hostname exactly.
TURNSTILE_HOSTNAMES=qatool-staging.vercel.app

# Default already; must equal the frontend's VITE_TURNSTILE_ACTION.
TURNSTILE_ACTION=qatool_demo

# The Docker network gateway, which is how the host's cloudflared appears to the container.
# Confirm: docker network inspect qatool_qatool-net --format "{{range .IPAM.Config}}{{.Gateway}}{{end}}"
TRUSTED_PROXY_PEERS=172.18.0.1

# Deliberately NOT set for staging (the defaults stay): JOB_WORKERS (1), JOB_MAX_PENDING (10),
# APAYEE_MAX_CONCURRENT (1, Apayee's own setting), PUBLIC_MODE (cannot be combined with PUBLIC_DEMO).
