# Frontend settings for the free staging deployment: the Vercel project qatool-staging.
# docs/STAGING_DEPLOYMENT.md sections 4 and 7.
#
# THIS FILE IS NOT READ BY ANYTHING. It lists what to set in Vercel (Project Settings > Environment
# Variables > Production, or `vercel env add <NAME> production`). Vercel is not given a file.
#
# EVERY VALUE HERE IS PUBLIC: Vite copies it into the JavaScript anyone can download. The Turnstile
# SECRET key, TICKET_SECRET and APAYEE_TOKEN must never appear here or in Vercel.
# Read at BUILD time: changing one needs a new deployment.

VITE_PUBLIC_DEMO=true

# The Quick Tunnel's origin, e.g. https://<random-words>.trycloudflare.com (https, origin only, no path).
# It CHANGES every time the tunnel is restarted, so this value and a redeploy follow each restart.
VITE_API_BASE_URL=

# The Turnstile widget's public SITE key (not the secret key).
VITE_TURNSTILE_SITE_KEY=

# Must equal the backend's TURNSTILE_ACTION.
VITE_TURNSTILE_ACTION=qatool_demo
