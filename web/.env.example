# Build-time settings for the browser app (read by Vite; copy to web/.env.production.local or set them
# in the Vercel project). EVERY VITE_ VALUE IS PUBLIC: it is copied into the JavaScript that anyone can
# download. Never put a token, a signing key or a Turnstile SECRET key here - those belong to the
# backend only (see the root .env.example). The browser never sees them.
#
# With none of these set you get the local tool, unchanged: relative /api/... calls answered by the
# Vite dev proxy (or by the server that serves the build), and the model picker.

# "true" builds the public demo: Turnstile check, a short-lived session ticket held in memory, work
# submitted as queued jobs, no model picker. Anything else is the local tool.
VITE_PUBLIC_DEMO=

# The API's origin, e.g. https://api.example.com (no path, https unless it is localhost). Empty keeps
# relative URLs. The backend must list this site's own origin in its ALLOWED_ORIGINS.
VITE_API_BASE_URL=

# The Turnstile widget's public SITE key (the secret key stays on the backend as TURNSTILE_SECRET).
VITE_TURNSTILE_SITE_KEY=

# Optional. Must equal the backend's TURNSTILE_ACTION (default qatool_demo).
VITE_TURNSTILE_ACTION=
